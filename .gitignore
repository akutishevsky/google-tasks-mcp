node_modules/
build/
.env
.DS_Store
*.log
.vscode/
.idea/

# Terraform: deployment-specific values stay out of the repo
infra/*.tfvars
!infra/terraform.tfvars.example
infra/backend.hcl
infra/.terraform/
infra/.terraform.lock.hcl
infra/*.tfstate*

infra-aws/*.tfvars
!infra-aws/terraform.tfvars.example
infra-aws/backend.hcl
infra-aws/.terraform/
infra-aws/.terraform.lock.hcl
infra-aws/*.tfstate*

# Child module init artifacts (the module is reusable; its lock file and
# provider cache are environment-specific and never committed)
infra-aws/modules/google-tasks-mcp/.terraform/
infra-aws/modules/google-tasks-mcp/.terraform.lock.hcl

# Google OAuth client downloads (credentials go to Secret Manager, never git)
client_secret_*.json
