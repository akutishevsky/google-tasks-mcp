#!/usr/bin/env bash
#
# pre-push hook: ensure the committed Lambda artifact is in sync with src/.
#
# If any tracked file under src/ is part of the push range, rebuild the bundle
# with `npm run build:lambda:zip` and compare the freshly built bundle against
# the bundle inside the COMMITTED zip (read from the pushed commit, not the
# working tree). We compare the extracted index.mjs CONTENT, not raw zip bytes,
# because a zip embeds file mtimes and would differ even when byte-identical.
# The working-tree zip is restored afterwards so the hook leaves no changes.
#
# Exit 1 (blocking the push) when src/ changed but the committed zip is stale or
# missing; exit 0 otherwise.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

ZIP_PATH="infra-aws/src/lambda.zip"
ZERO_OID="0000000000000000000000000000000000000000"

# Find the tip commit of the push range, and whether src/ changed in it.
src_changed=0
tip_oid=""
while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_oid" = "$ZERO_OID" ] && continue # ref deletion
  tip_oid="$local_oid"
  if [ "$remote_oid" = "$ZERO_OID" ]; then
    changed="$(git diff --name-only "$local_oid")"
  else
    changed="$(git diff --name-only "$remote_oid".."$local_oid")"
  fi
  printf '%s\n' "$changed" | grep -q '^src/' && src_changed=1
done

[ "$src_changed" -eq 0 ] && exit 0

echo "pre-push: src/ changed; verifying $ZIP_PATH is up to date..."

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"; git checkout -- "$ZIP_PATH" 2>/dev/null || true' EXIT

bundle_hash() { unzip -p "$1" index.mjs 2>/dev/null | shasum -a 256 | awk '{print $1}'; }

stale_message() {
  cat <<EOF
pre-push: the committed $ZIP_PATH is stale (it does not match the current src/).
Rebuild and commit the Lambda artifact before pushing:

  npm run build:lambda:zip
  git add $ZIP_PATH

then re-commit and push again.
EOF
}

# The committed artifact, read from the commit being pushed (falls back to HEAD).
ref="${tip_oid:-HEAD}"
if ! git cat-file -e "${ref}:${ZIP_PATH}" 2>/dev/null; then
  echo "pre-push: $ZIP_PATH is not committed in the pushed range."
  stale_message
  exit 1
fi
git show "${ref}:${ZIP_PATH}" > "$TMP/committed.zip"
committed_hash="$(bundle_hash "$TMP/committed.zip")"

# The source of truth: rebuild from the current src/ and hash the fresh bundle.
if ! npm run --silent build:lambda:zip >/dev/null 2>&1; then
  echo "pre-push: 'npm run build:lambda:zip' failed; run it manually and fix the error."
  exit 1
fi
fresh_hash="$(bundle_hash "$ZIP_PATH")"

if [ "$committed_hash" != "$fresh_hash" ]; then
  echo "pre-push: bundle hash mismatch."
  echo "  committed in zip: ${committed_hash:-<none>}"
  echo "  freshly built:    $fresh_hash"
  stale_message
  exit 1
fi

echo "pre-push: $ZIP_PATH is up to date."
exit 0
