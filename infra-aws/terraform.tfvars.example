# Copy to terraform.tfvars (git-ignored) and fill in. Never commit real values.
# The values below mirror the deploy target as a worked example; replace them.
region               = "eu-west-1"
issuer_url           = "https://gtasks-mcp.fliuzzi-pg-812297029389.aws.sidea.space"
allowed_domain       = "<domain>"
privacy_policy_url   = "https://<your-site>/privacy" # optional; /privacy-policy redirects here
custom_domain        = "gtasks-mcp.fliuzzi-pg-812297029389.aws.sidea.space"
enable_custom_domain = true # creates the ACM cert (regional, in `region`) + API Gateway custom domain

# In-account Route 53 path: set the hosted zone ID and a single `terraform apply`
# writes the ACM validation records, waits for ISSUED, and creates the alias
# record for custom_domain -- no manual DNS steps. Leave empty if the zone lives
# in another account; then create the acm_validation_records / custom_domain_target
# records by hand.
route53_zone_id = "Z005738529V6EIA0ALNXF"

lambda_zip_path = "../build/lambda.zip" # zip of build/lambda/ (npm run build:lambda)
